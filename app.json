{
  "expo": {
    "name": "Utilitati.MD",
    "owner": "vadikonline1",
    "slug": "utilitatimd",
    "scheme": "utilitati",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f766e",
          "sounds": []
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0f766e",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "md.utilitati.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "md.utilitati.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      },
      "notification": {
        "icon": "./assets/icon.png",
        "color": "#0f766e"
      }
    },
    "extra": {
      "apiUrl": "https://utilitati.nistorlazar.md/api",
      "eas": {
        "projectId": "a6825545-6d60-4504-aafd-0f8d7c1e9f56"
      },
      "expo": {
        "projectId": "a6825545-6d60-4504-aafd-0f8d7c1e9f56"
      }
    }
  }
}
