# utilitati_md application environment -- EXAMPLE TEMPLATE (safe to commit).
#
# Copy this file to `.env` on the server and fill in real values:
#   cp .env.example .env
# The real `.env` is git-ignored, so it will NOT be committed.
# Loaded by docker compose via `env_file: path: .env`.

# ---- CRYPTO (REQUIRED IN PRODUCTION) ----------------------------------------
# Used to derive the at-rest encryption key (AES-GCM/Fernet) for SMTP/Telegram
# credentials and user notification data. MUST be a strong random value that is
# never committed. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UTILITATI_SECRET_KEY=change-me-in-production

# ---- AUTH -------------------------------------------------------------------
# SINGLE default account (NO commas/spaces -- this is the account name created
# at startup). If you paste a comma list here by mistake, only the first word
# is used, e.g. "admin, administrator" becomes "admin".
UTILITATI_USERNAME=admin
UTILITATI_PASSWORD=admin

# Comma-separated list of usernames (existing accounts) that can access the
# /admin dashboard. Leave as 'admin' to match the default login above.
UTILITATI_ADMIN_USERNAME=admin

# ---- PUBLIC SITE URL --------------------------------------------------------
# Base URL used to build invitation / password-reset links in emails.
UTILITATI_SITE_URL=https://utilitati.nistorlazar.md

# ---- DATABASE ---------------------------------------------------------------
# SQLite is the default and works out of the box (no DB server required).
# The database file lives on the Docker volume so it survives rebuilds, and the
# app runs in WAL mode + busy_timeout so many readers/one writer at a time do
# not block or lock up.
UTILITATI_DB=/app/data/utilitati.db

# ---- EMAIL (SMTP) -----------------------------------------------------------
# Optional: configure the mail server here instead of (or overriding) /admin.
# Leave empty to configure only from the admin panel.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=no-reply@example.com

# ---- TELEGRAM BOT -----------------------------------------------------------
# Optional: configure the notification bot here instead of (or overriding) /admin.
# TELEGRAM_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOTNAME=utilitati_md_bot