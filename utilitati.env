# utilitati_md application environment.
# Loaded by docker compose via `env_file: utilitati.env`.
# IMPORTANT: replace the placeholder SECRET_KEY with a long random string
# before going to production (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))").

UTILITATI_SECRET_KEY=change-me-in-production
UTILITATI_USERNAME=admin
UTILITATI_PASSWORD=admin

# SQLite database lives on the volume so it survives rebuilds.
UTILITATI_DB=/app/data/utilitati.db
