# utilitati_md application environment.
# Loaded by docker compose via `env_file: utilitati.env`.

# ---- CRYPTO (REQUIRED IN PRODUCTION) ----------------------------------------
# This secret is used to derive the at-rest encryption key (AES-GCM/Fernet) for
# SMTP/Telegram credentials and user notification data. If it stays at the
# default value the encrypted values can still be read by anyone with the repo.
# Generate a strong random value and PUT IT ON THE SERVER ONLY (never commit):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UTILITATI_SECRET_KEY=change-me-in-production

# ---- AUTH ---------------------------------------------------------------
UTILITATI_USERNAME=admin
UTILITATI_PASSWORD=admin

# Username that can access the /admin dashboard (configure SMTP, Telegram bot,
# sync period). Leave as 'admin' to match the default login above.
UTILITATI_ADMIN_USERNAME=admin

# ---- PUBLIC SITE URL ----------------------------------------------------
# Base URL used to build invitation / password-reset links in emails.
UTILITATI_SITE_URL=https://utilitati.nistorlazar.md

# ---- DATABASE ---------------------------------------------------------------
# SQLite database lives on the volume so it survives rebuilds.
UTILITATI_DB=/app/data/utilitati.db
