# Don't upload the checked-in Expo/CLI native directories to EAS Build.
# EAS runs `expo prebuild` on its side; keeping ios/ and android/ local avoids
# stale generated projects causing conflicts.
ios/
android/

# Local secrets never sent to EAS.
utilitati.db
utilitati.env
.env
.env.*
*.p12
*.p8
*.mobileprovision
service-account-key.json

# NOTE: GoogleService-Info.plist / google-services.json are intentionally NOT
# ignored here — they are referenced by app.json (ios.googleServicesFile /
# android.googleServicesFile) and are committed to git, so EAS must upload them.

# Build output / caches.
node_modules/
.expo/
dist/