{
  "expo": {
    "name": "Utilitati.MD",
    "slug": "utilitati-mobile",
    "scheme": "utilitati",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0f766e",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "md.utilitati.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "md.utilitati.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      }
    },
    "extra": {
      "apiUrl": "https://utilitati.nistorlazar.md/api"
    }
  }
}
